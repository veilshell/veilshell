#!/usr/bin/env python3
"""Run explicitly enabled XDG autostart entries in a standalone VeilShell session."""

import fcntl
import os
from pathlib import Path
import shutil
import signal
import stat
import subprocess
import sys
import time


ENTRY = "Desktop Entry"


def log(message):
    print(f"veilshell-autostart: {message}", file=sys.stderr, flush=True)


def session_directory():
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", ""))
    directory = Path(os.environ.get("VEILSHELL_SESSION_DIR", ""))
    wayland = os.environ.get("WAYLAND_DISPLAY", "")
    hyprland = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    if (
        not runtime.is_absolute()
        or directory.parent != runtime
        or not directory.name.startswith("veilshell.")
        or not wayland
        or not hyprland
        or Path(hyprland).name != hyprland
        or hyprland in (".", "..")
    ):
        raise ValueError("not running inside a standalone VeilShell session")
    st = directory.lstat()
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid() or st.st_mode & 0o077:
        raise ValueError("invalid standalone session directory")
    if (
        (directory / "display").read_text().splitlines() != [wayland, hyprland]
        or not (runtime / wayland).is_socket()
        or not (runtime / "hypr" / hyprland / ".socket.sock").is_socket()
    ):
        raise ValueError("standalone display does not match or is not ready")
    return directory


def config_directories():
    home = Path(os.environ.get("XDG_CONFIG_HOME", ""))
    if not home.is_absolute():
        home = Path.home() / ".config"
    system = os.environ.get("XDG_CONFIG_DIRS") or "/etc/xdg"
    return [home, *(Path(p) for p in system.split(":") if Path(p).is_absolute())]


def enabled_entries(home):
    try:
        lines = (home / "veilshell" / "autostart.list").read_text().splitlines()
    except FileNotFoundError:
        return
    seen = set()
    for line in lines:
        name = line.strip()
        if not name or name.startswith("#"):
            continue
        if Path(name).name != name or not name.endswith(".desktop") or "\0" in name:
            log(f"ignoring invalid desktop file name {name!r}")
        elif name not in seen:
            seen.add(name)
            yield name


def find_entry(directories, name):
    for directory in directories:
        path = directory / "autostart" / name
        try:
            path.lstat()
        except FileNotFoundError:
            continue
        # A broken or invalid higher-priority file still masks lower-priority files.
        if not path.is_file():
            raise ValueError("not a readable desktop file")
        return path
    raise ValueError("no matching desktop file")


def optional(GLib, reader, key, default):
    try:
        return reader(ENTRY, key)
    except GLib.Error as error:
        if not error.matches(GLib.key_file_error_quark(), GLib.KeyFileError.KEY_NOT_FOUND):
            raise
        return default


def launch_plan(GLib, path):
    entry = GLib.KeyFile.new()
    entry.load_from_file(str(path), GLib.KeyFileFlags.NONE)

    def string(key, default=""):
        return optional(GLib, entry.get_string, key, default)

    def values(key):
        return optional(GLib, entry.get_string_list, key, [])

    def boolean(key, default=False):
        return optional(GLib, entry.get_boolean, key, default)

    if (
        string("Type") != "Application"
        or boolean("Hidden")
        or not boolean("X-GNOME-Autostart-enabled", True)
    ):
        return None
    desktops = {"VeilShell", "Hyprland"}
    only = values("OnlyShowIn")
    if (only and desktops.isdisjoint(only)) or desktops.intersection(values("NotShowIn")):
        return None
    if boolean("Terminal") or boolean("DBusActivatable"):
        raise ValueError("terminal and D-Bus activated entries are not supported")
    keys, _ = entry.get_keys(ENTRY)
    if set(keys).intersection({
        "AutostartCondition", "X-KDE-autostart-condition",
        "X-GNOME-Autostart-Phase", "X-GNOME-Autostart-Delay",
    }):
        raise ValueError("desktop-specific conditions, phases and delays are not supported")
    try_exec = string("TryExec")
    if try_exec and not (valid_executable(try_exec) and shutil.which(try_exec)):
        return None

    # GLib handles key-file escaping and quoted arguments. Neither this parser
    # nor Popen evaluates a shell expression. There are no input files/URLs.
    _, tokens = GLib.shell_parse_argv(string("Exec"))
    if not tokens or not valid_executable(tokens[0]) or "%" in tokens[0]:
        raise ValueError("Exec needs an executable name or absolute path")
    argv = [tokens[0]]
    for token in tokens[1:]:
        if token in ("%f", "%F", "%u", "%U"):
            continue
        if token == "%c":
            argv.append(entry.get_locale_string(ENTRY, "Name", None))
        elif token == "%k":
            argv.append(str(path))
        elif token == "%i":
            if icon := string("Icon"):
                argv.extend(("--icon", icon))
        elif "%" in token.replace("%%", ""):
            raise ValueError("unsupported Exec field code or placement")
        else:
            argv.append(token.replace("%%", "%"))
    cwd = string("Path")
    if cwd and not Path(cwd).is_absolute():
        raise ValueError("Path is not absolute")
    return argv, cwd or None


def valid_executable(program):
    return bool(program) and ("/" not in program or Path(program).is_absolute())


def supervise(directories, enabled):
    from gi.repository import GLib

    stopping = False

    def stop(*_):
        nonlocal stopping
        stopping = True

    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, stop)

    anchor = None
    children = {}
    launched = False
    try:
        for name in enabled:
            if stopping:
                break
            try:
                path = find_entry(directories, name)
                plan = launch_plan(GLib, path)
                if plan is None:
                    continue
                if anchor is None:
                    # Keep the owned process group distinct from the compositor
                    # and launcher. Retain its leader until the last signal, so
                    # the group ID can't be reused mid-teardown.
                    anchor = subprocess.Popen(["sleep", "infinity"], process_group=0)
                argv, cwd = plan
                children[name] = subprocess.Popen(argv, cwd=cwd, process_group=anchor.pid)
                launched = True
            except (GLib.Error, OSError, ValueError) as error:
                log(f"skipping {name!r}: {error}")

        # Keep supervising even if a wrapper has exited; its descendants may
        # still be running in the owned group.
        while launched and not stopping:
            for name, child in list(children.items()):
                status = child.poll()
                if status is not None:
                    del children[name]
                    if status:
                        log(f"{name!r} exited with status {status}")
            time.sleep(0.25)
    finally:
        if anchor is not None:
            for sig in (signal.SIGTERM, signal.SIGKILL):
                try:
                    os.killpg(anchor.pid, sig)
                except ProcessLookupError:
                    break
                if sig == signal.SIGTERM and launched:
                    time.sleep(0.75)
            anchor.wait()
            for child in children.values():
                child.wait(timeout=0.5)


def main():
    try:
        directory = session_directory()
        directories = config_directories()
        enabled = list(enabled_entries(directories[0]))
        if not enabled:
            return 0
        # Lock the directory itself: no additional file for the launcher to clean up.
        fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                return 0
            supervise(directories, enabled)
        finally:
            os.close(fd)
    except (ImportError, OSError, ValueError, subprocess.TimeoutExpired) as error:
        log(str(error))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
